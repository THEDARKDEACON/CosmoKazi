# ==============================================================================
# CosmoKazi Mars Rover — .gitignore
# ==============================================================================

# ── ROS 2 / Colcon Build Artefacts ──────────────────────────────────────────
build/
install/
log/
cosmokazi_ws/build/
cosmokazi_ws/install/
cosmokazi_ws/log/

# ── Gazebo Procedural Asset Cache ────────────────────────────────────────────
# Generated by procgen pipeline — regenerate with .docker/run.bash
space_robotics_gz_envs/assets/cache/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
.eggs/
.pytest_cache/

# ── C++ Build Outputs ────────────────────────────────────────────────────────
*.o
*.a
*.so.*
*.out
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ── ROS Logs & Bag Files ─────────────────────────────────────────────────────
~/.ros/log/
*.bag
*.db3
*.mcap

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
secrets/

# ── PDFs & Binary Documents (keep tracked separately if needed) ───────────────
*.pdf
*.docx
*.xlsx

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.txt
Thumbs.db
space_robotics_gz_envs/assets/cache/
space_robotics_gz_envs/assets/srb_assets/
space_robotics_gz_envs/install/
space_robotics_gz_envs/log/
space_robotics_gz_envs/src/

space_robotics_gz_envs/build/
*.obj

# ── Simulation & Dependency Packages ───────────────────────────────────────
cosmokazi_ws/src/husarion_components_description/
cosmokazi_ws/src/husarion_gz_worlds/
cosmokazi_ws/src/realsense-ros/
cosmokazi_ws/src/rosbot_xl_ros/
cosmokazi_ws/src/rover_control/rosbot_xl_ros/